# App
NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/inbound_automation?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Encryption (32 bytes for AES-256-GCM)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Rate Limits (per sender account)
RATE_LIMIT_DAILY=20
RATE_LIMIT_DEFAULT_WEEKLY=80
RATE_LIMIT_PREMIUM_WEEKLY=150

# Webhook
WEBHOOK_SECRET=your-webhook-secret-for-signature-verification

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=your-local-test-token-for-authentication